<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>PhoneSnap</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>发现并连接你已配对的 Mac，直接发送所选截图或图片。</string>
    <key>NSBonjourServices</key><array><string>_phonesnap._tcp</string></array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>PhoneSnap Pairing</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Owner</string>
            <key>LSItemContentTypes</key>
            <array><string>dev.phonesnap.pairing</string><string>dev.phonesnap.relay-pairing</string></array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>dev.phonesnap.pairing</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
            <key>UTTypeDescription</key><string>Private nearby pairing</string>
            <key>UTTypeTagSpecification</key>
            <dict><key>public.filename-extension</key><array><string>phonesnappair</string></array></dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key><string>dev.phonesnap.relay-pairing</string>
            <key>UTTypeConformsTo</key><array><string>public.data</string></array>
            <key>UTTypeDescription</key><string>Private encrypted relay pairing</string>
            <key>UTTypeTagSpecification</key>
            <dict><key>public.filename-extension</key><array><string>phonesnaprelay</string></array></dict>
        </dict>
    </array>
</dict>
</plist>
